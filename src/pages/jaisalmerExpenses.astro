---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Jaisalmer Expenses";
---

<BaseLayout pageTitle={pageTitle}>
	<div class="min-h-screen px-4 sm:px-6 py-6 sm:py-10">
		<div
			class="max-w-3xl mx-auto bg-white/90 backdrop-blur-md rounded-2xl shadow-xl p-5 sm:p-8"
		>
			<!-- Header -->
			<h1
				class="text-xl sm:text-3xl font-semibold text-center leading-snug mb-6"
			>
				🏜 Jaisalmer Expenses
			</h1>

			<!-- Dropdown -->
			<div class="mb-6 mt-10">
				<label class="block mb-2 font-semibold text-sm sm:text-base">
					Select Authorized Individual:
				</label>
				<select
					id="personSelect"
					class="w-full p-3 text-sm sm:text-base rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#779e8c]"
				>
					<option value="">-- Choose wisely --</option>
					<option value="Brijen">Brijen Kharawala</option>
					<option value="Harsh">Harsh Shah</option>
					<option value="Shailesh">Shailesh Purohit</option>
					<option value="Raj">Raj Panchal</option>
					<option value="Jhanvi">Jhanvi Chocha</option>
					<option value="Grishma">Grishma Patoliya</option>
				</select>
			</div>

			<!-- Expense Section -->
			<div id="expenseSection" class="hidden transition-all duration-500">
			</div>

			<!-- QR Button -->
			<div id="qrButtonContainer" class="mt-8 text-center hidden">
				<button
					id="generateQR"
					class="border border-zinc-950 rounded tag_button text-sm p-2 outline-none"
				>
					💳 Generate QR Code
				</button>
			</div>

			<!-- QR Container -->
			<div
				id="qrContainer"
				class="mt-6 hidden flex flex-col items-center justify-center text-center"
				>
				<div
					class="mx-auto w-40 h-40 sm:w-52 sm:h-52 bg-white rounded-xl shadow-lg relative overflow-hidden flex items-center justify-center"
				>
					<div
						id="qrLoader"
						class="absolute inset-0 bg-black animate-pulse text-center"
					>
					</div>
					<img
						id="qrImage"
						src="/imgs/temp/qr_code.png"
						class="hidden w-full h-full object-contain"
					/>
				</div>
				<p class="mt-3 font-semibold text-sm sm:text-base">
					🤝 Scan responsibly. Friendship depends on it.
				</p>
			</div>

			<!-- Feedback -->
			<div class="mt-10 text-center">
				<p class="text-sm">
					Curious to know more about Taksh?
					<a
						href="https://its-taksh.vercel.app/"
						target="_blank"
						class="underline font-semibold"
					>
						Click here.
					</a>
				</p>
			</div>

			<!-- Footer Line -->
			<div
				class="mt-8 text-center text-sm sm:text-base font-medium leading-relaxed"
			>
				🤝 Stay connected with Taksh & keep vibes flowing or Taksh will
				reopen conversation with full enthusiasm.
			</div>
		</div>
	</div>

	<script>
		const select = document.getElementById("personSelect");
		const expenseSection = document.getElementById("expenseSection");
		const qrButtonContainer = document.getElementById("qrButtonContainer");
		const qrContainer = document.getElementById("qrContainer");
		const qrLoader = document.getElementById("qrLoader");
		const qrImage = document.getElementById("qrImage");

		select.addEventListener("change", () => {
			const value = select.value;
			expenseSection.classList.remove("hidden");
			qrContainer.classList.add("hidden");

			if (["Brijen", "Harsh", "Shailesh", "Raj"].includes(value)) {
				expenseSection.innerHTML = `
          <div class="bg-red-100 p-4 sm:p-6 rounded-xl shadow-md text-center text-sm sm:text-base">
            🚫 Classified Information.<br/><br/>
            Expense visibility privileges are currently suspended for this profile.  
            Upgrade your friendship tier to unlock premium transparency.
          </div>
        `;
				qrButtonContainer.classList.add("hidden");
			} else {
				expenseSection.innerHTML = `
          <div class="grid gap-5 mt-5">
            <div class="p-4 flex justify-center items-center flex-col">
              <img src="/imgs/temp/main_fort.jfif" class="w-227.5 mb-5"/>
              <p class="text-sm sm:text-base">🏰 Jaisalmer Fort: ₹200</p>
            </div>
            <div class="p-4 flex justify-center items-center flex-col">
              <img src="/imgs/temp/patwa_haveli.jfif" class="w-227.5 mb-5"/>
              <p class="text-sm sm:text-base">🏛️ Patwa Haveli: ₹150</p>
            </div>
			<div class="p-4 flex justify-center items-center flex-col">
              <img src="/imgs/temp/bada_baug.jfif" class="w-227.5 mb-5"/>
              <p class="text-sm sm:text-base">🌳 Bada Baug Visit: ₹150</p>
            </div>
			<div class="p-4 flex justify-center items-center flex-col">
              <img src="/imgs/temp/war_museum.jfif" class="w-227.5 mb-5"/>
              <p class="text-sm sm:text-base">🎖️ War Museum: ₹100</p>
            </div>
			<div class="p-4 flex justify-center items-center flex-col">
              <img src="/imgs/temp/kuldhara_vlg.png" class="w-227.5 mb-5"/>
              <p class="text-sm sm:text-base">🏚️ Kuldhara Village: ₹40</p>
            </div>
			<div class="p-4 flex justify-center items-center flex-col">
              <img src="/imgs/temp/khabha_fort.png" class="w-227.5 mb-5"/>
              <p class="text-sm sm:text-base">🗼 Khabha Fort: ₹30</p>
            </div>
			<div class="p-4 flex justify-center items-center flex-col">
              <p class="text-sm sm:text-base">🐪 Desert Safari: ₹300</p>
			  <p class="text-sm sm:text-base">🍽️ Day-3 Lunch: ₹200</p>
            </div>

            <div class="flex justify-center items-center font-bold text-right text-base sm:text-lg">
              Grand Total: ₹1170
            </div>
          </div>
        `;
				qrButtonContainer.classList.remove("hidden");
			}
		});

		document.getElementById("generateQR").addEventListener("click", () => {
			qrContainer.classList.remove("hidden");
			qrLoader.classList.remove("hidden");
			qrImage.classList.add("hidden");

			setTimeout(() => {
				qrLoader.classList.add("hidden");
				qrImage.classList.remove("hidden");
			}, 1500);
		});
	</script>
</BaseLayout>
